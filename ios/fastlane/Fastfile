default_platform(:ios)

platform :ios do
  desc "Envia build assinado para o Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"] || "DLAT4853PY",
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"] || "344eae33-78e5-41b3-b920-b3f09b5b819a",
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    # Gera o IPA pronto para distribuição
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )

    # Faz o upload no TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
